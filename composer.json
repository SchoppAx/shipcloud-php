{
    "name": "schoppax/shipcloud-php",
    "description": "shipcloud API v1 PHP 8.2+ library",
    "keywords": [
        "php",
        "shipcloud",
        "api"
    ],
    "authors": [
        {
            "name": "comyo.media",
            "email": "support@comyo-media.de"
        },
        {
            "name": "Dennis Oderwald",
            "email": "oderwald@comyo-media.de"
        }
    ],
    "require": {
        "php": ">=8.2.0",
        "guzzlehttp/guzzle": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "ComyoMedia\\Shipcloud\\": "src/"
        }
    },
    "scripts": {
        "start": [
            "php -S localhost:8080"
        ],
        "test": [
            "phpunit --configuration phpunit.xml"
        ],
        "analyse": [
            "phpstan analyse -c phpstan.neon --no-progress"
        ]
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.3"
    }
}
